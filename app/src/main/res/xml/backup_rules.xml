<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Preserve only non-secret preferences. Session sources may contain private
      or multi-megabyte documents, and encrypted API-key blobs cannot be restored
      without their device-bound Android Keystore key.
    -->
    <include
        domain="sharedpref"
        path="sonario_settings.xml"
        requireFlags="clientSideEncryption|deviceToDeviceTransfer" />

    <!-- Once an include exists, Android excludes every path not allowlisted. -->
</full-backup-content>
